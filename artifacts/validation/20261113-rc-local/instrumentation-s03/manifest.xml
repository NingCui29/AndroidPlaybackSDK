<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cn.media.playback.test" >

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="23" />

    <instrumentation
        android:name="com.cn.media.playback.InputChecks"
        android:functionalTest="false"
        android:handleProfiling="false"
        android:label="Tests for com.cn.media.playback.test"
        android:targetPackage="com.cn.media.playback.test" />

    <application
        android:debuggable="true"
        android:extractNativeLibs="false" >
        <provider
            android:name="com.cn.media.playback.FixtureProvider"
            android:authorities="com.cn.media.playback.test.fixture"
            android:exported="false" />

        <activity
            android:name="com.cn.media.playback.DisplayActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <uses-library android:name="android.test.runner" />
    </application>

</manifest>