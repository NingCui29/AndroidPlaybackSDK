<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- 视频绘制主 Surface -->
    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 触摸交互透明层 (用于点击唤起/收起控制栏) -->
    <View
        android:id="@+id/touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 缓冲等待转圈 -->
    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- 顶部控制与输入栏 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_control_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="36dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Playback Demo"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_path"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="#25FFFFFF"
            android:hint="输入媒体文件路径 (MP4/MKV/FLV等)"
            android:inputType="textUri"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="/sdcard/Download/benchmark/V01.mp4"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_pick_file"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="选择文件"
            android:textColor="#80D8FF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_open"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="打开并播放"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_toggle_hud"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="HUD:开"
            android:textColor="#80D8FF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 实时性能与诊断悬浮窗 (HUD) -->
    <LinearLayout
        android:id="@+id/hud_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="88dp"
        android:background="@drawable/bg_hud"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/hud_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="实时性能与诊断监控 (HUD)"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hud_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="状态: IDLE\n分辨率: -\n渲染帧: 0 | 丢帧: 0 (0.00%)\n音频已消费: 0 帧\n上次Seek耗时: -\n内存 (PSS): - MB"
            android:textColor="#ECEFF1"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_control_bar"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- 进度条行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0" />

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 控制按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_button"
                android:minWidth="60dp"
                android:minHeight="0dp"
                android:text="播放"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:minWidth="56dp"
                android:minHeight="0dp"
                android:text="停止"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_step_back"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:minWidth="48dp"
                android:minHeight="0dp"
                android:text="-10s"
                android:textColor="#ECEFF1"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_step_forward"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:minWidth="48dp"
                android:minHeight="0dp"
                android:text="+10s"
                android:textColor="#ECEFF1"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_fast_seek"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="FastSeek:开"
                android:textColor="#00E676"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_decode_mode"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="解码:AUTO"
                android:textColor="#80D8FF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_aspect_ratio"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="比例:自适应"
                android:textColor="#E040FB"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_mute"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_button"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="静音:关"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seek_volume"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:max="100"
                android:progress="100" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
